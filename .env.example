### All configurable environment variable must show up in this sample file in active or comment out status
### Please manually copy and rename（copy .env.example .env）to .env
### By default, all variables are designed local on-primer server with Ollama support for quick kickoff AgentSeed

###########################
#### Server Configuration
############################
### HOST=localhost binds to this machine only (recommended default).
### PORT is set to 2026 by default.
### Switching HOST to 0.0.0.0 exposes the server on your network: anyone who can
### reach it then has full access to your documents and knowledge graph. Only do
### that on a trusted network.
HOST=localhost
PORT=2026

### Logging level - DEBUG, INFO, WARNING, ERROR, CRITICAL
# By default, sys.stdout is used for logging
LOG_LEVEL=DEBUG
### Logfile location (defaults to current working directory)
# LOG_DIR=/path/to/log/directory
LOG_DIR=./logs
### How many rotated file logs (agentseed.log.YYYYMMDD) to keep. 0 = keep them all forever.
# LOG_BACKUP_COUNT=7

### Windows only: backend/main.py re-executes itself once with PYTHONUTF8=1 to avoid GBK
### (cp936) decoding errors. Set this to 1 to skip the re-exec (handy under pdb / pytest).
# SKIP_UTF8_RESTART=1
### Interpreter guard: backend/main.py re-executes itself inside <repo>/.venv when it was
### started with another interpreter (system Python, conda base, an IDE SDK that never ran
### `uv sync`). Set this to 1 to skip that switch (useful when attaching a debugger).
### Must be set in the PROCESS environment — .env is loaded later, so it cannot turn
### this guard off.
# SKIP_VENV_RESTART=1


###########################
#### LLM Static Configuration
############################
### Called by：backend/src/core/llm.py  build_chat_model()（Entry Point）。
### Each variable is only defined once （dotenv variable can override if you want）。

# ===== LLM Provider Switch：local | openai =====
# local  = Local Ollama（default locally, no token required）
# openai = Any OpenAI-compatible endpoint（DeepSeek / qwen / glm, kimi ...），
LLM_PROVIDER=local

### Local LLM Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURE=0.2

### Online API LLM Configuration
### The switch itself is declared once, in the "LLM Provider Switch" block above — dotenv
### keys are overridden by the last definition, so it is deliberately not repeated here.
### Only read when LLM_PROVIDER=openai.
# ===== Online OpenAI-compatible endpoint (DeepSeek/qwen/glm/kimi) =====
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-flash
OPENAI_TEMPERATURE=0.2


# # Multimodal LLM Configuration
# # Explicit declaration here or implicit declaration by env variable
# MULTIMODAL_API_KEY=<your-ark-api-key>
# MULTIMODAL_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# MULTIMODAL_MODEL=doubao-seed-1-6-vision-250815

# # Switch to enable PDF multimodal mode
# ENABLE_PDF_MULTIMODAL=true



# Name of Application
app_name=AgentSeed



# ===== LangGraph Runtime Configuration =====
# Storage / runtime edition
DATABASE_URI=:memory:
REDIS_URI=fake
MIGRATIONS_PATH=__inmem

# Server configuration
ALLOW_PRIVATE_NETWORK=true  
### NOTE: this flag alone does NOT serve a Studio UI. langgraph_api only builds the
### /ui bundle when the internal LANGGRAPH_UI variable is set (normally injected by
### the langgraph CLI from langgraph.json) AND Node.js/npx is available. AgentSeed
### never sets LANGGRAPH_UI, so /ui stays unavailable - use /docs, or point an
### external chat UI (e.g. langchain-ai/agent-chat-ui) at this server.
LANGGRAPH_UI_BUNDLER=true
LANGGRAPH_RUNTIME_EDITION=inmem
LANGSMITH_LANGGRAPH_API_VARIANT=local_dev
LANGGRAPH_DISABLE_FILE_PERSISTENCE=false
LANGGRAPH_ALLOW_BLOCKING=true

# Worker configuration
N_JOBS_PER_WORKER=1


###########################
#### Hermes Agent Integration (graph: hermes_agent)
############################
### Every Hermes setting is read from this file -- agents/samples/hermesAgent.py
### hardcodes no host, token, model id or timeout. This graph does NOT use
### LLM_PROVIDER / OLLAMA_* / OPENAI_*: the other end is a locally running Hermes
### Agent answering over its OpenAI-compatible HTTP API.
### Enable the API server on the Hermes side (~/.hermes/.env:
### API_SERVER_ENABLED=true plus API_SERVER_KEY) and mirror the SAME key below.
### When no Hermes runs on this machine, remove the hermes_agent entry from
### agentConfig.yaml -- otherwise the server refuses to start (the Python module
### raises "HERMES_BASE_URL is not set" / "API_SERVER_KEY is not set").

### [required] API server root; its OpenAI-compatible surface is derived as
### <root>/v1. Hermes' own default binding is 127.0.0.1:8642.
HERMES_BASE_URL=http://127.0.0.1:8642
### [required] Bearer token of that API server -- never commit a real key here.
API_SERVER_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
### [required] Model id Hermes advertises on GET /v1/models: "hermes-agent" for the
### default profile, otherwise the configured API_SERVER_MODEL_NAME.
HERMES_MODEL=hermes-agent

### [required] Seconds to wait for one Hermes turn (a turn may browse the web or run
### tools). Never leave it empty: the OpenAI-compatible client reads an absent
### timeout as "wait forever" (httpx Timeout(None)) rather than falling back to a
### library default.
HERMES_TIMEOUT=600
### [optional] HTTP retries -- each retry re-runs the whole remote agent, tool
### calls included. Leave EMPTY to use the SDK default (2).
HERMES_MAX_RETRIES=1
### [optional] X-Hermes-Session-Id / X-Hermes-Session-Key request headers. Leave
### empty when the client replays the whole history (this graph does), otherwise
### the remote agent sees every turn twice.
# HERMES_SESSION_ID=
# HERMES_SESSION_KEY=
### [optional] Bridge-level system prompt (empty = Hermes keeps its own persona).
# HERMES_SYSTEM_PROMPT=


###########################
#### MCP Configuration
############################
### MCP server credentials consumed by backend/src/capabilities/mcp/servers.yaml,
### which expands ${VAR} placeholders from this file — the servers.yaml committed
### to git therefore contains no secret.
### The `tavily` server backs the mcp_agent graph
### (agents/samples/mcpAgent.py). Get a key at https://tavily.com.
### Unlike hermes_agent, a missing key does NOT stop the server: mcp_agent logs
### an error and runs without web-search tools. Other graphs are unaffected.

### [optional] Tavily API key, sent as `Authorization: Bearer <key>` to the hosted
### remote MCP endpoint https://mcp.tavily.com/mcp/ (no local Node process needed).
### Leave EMPTY to run mcp_agent without MCP tools, or comment out the `tavily`
### entry in servers.yaml to disable the server entirely.
TAVILY_API_KEY=



